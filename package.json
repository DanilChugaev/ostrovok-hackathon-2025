{
  "name": "doc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "docker:prod": "docker compose down && docker compose up --build",
    "docker:dev": "docker compose down && docker compose --profile dev up --build",
    "lint": "eslint . --ext .js,.ts,.vue",
    "lint:fix": "eslint . --ext .js,.ts,.vue --fix",
    "format": "prettier --write \"src/**/*.{js,ts,vue}\"",
    "ts:check": "vue-tsc -b"
  },
  "dependencies": {
    "@primeuix/themes": "^1.2.4",
    "@primevue/forms": "^4.3.9",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^13.9.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.9",
    "vue": "^3.5.21",
    "vue-i18n": "11",
    "vue-router": "4",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@primevue/auto-import-resolver": "^4.3.9",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-vue": "^10.5.0",
    "msw": "^2.11.3",
    "prettier": "^3.6.2",
    "typescript": "~5.8.3",
    "unplugin-vue-components": "^29.1.0",
    "vite": "^7.1.7",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
